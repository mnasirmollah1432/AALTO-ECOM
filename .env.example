# ---------------------------------------------------------------
# Aalto Mart - environment configuration
# Copy this file to ".env" and fill in real values.
# Never commit the real .env file.
# Defaults below are for a live site; for local development set
# APP_ENV=local, APP_DEBUG=true and APP_URL=http://localhost:8080
# ---------------------------------------------------------------

# Application
APP_NAME="Aalto Mart"
# local | staging | production
# production: detailed errors are never shown, and every request is
# redirected to the scheme + host of APP_URL (http -> https, www -> bare)
APP_ENV=production
# true shows detailed errors (ignored when APP_ENV=production)
APP_DEBUG=false
# Full public URL with no trailing slash. Used for canonical URLs,
# the sitemap and social tags. Examples:
#   https://www.example.com
#   http://localhost:8080
#   http://localhost/AALTO-ECOM/public
APP_URL=https://www.example.com
APP_TIMEZONE=Asia/Dhaka

# Store / currency display
STORE_CURRENCY=BDT
STORE_CURRENCY_SYMBOL="৳"
# Delivery charges (per zone), districts, thanas and free delivery are set in
# Admin -> Delivery, not here.
STORE_EMAIL=hello@example.com
STORE_PHONE=
# Delivery country (ISO code) and return window, used in product
# structured data and the returns text on the site
STORE_COUNTRY=BD
STORE_RETURN_DAYS=7

# Database (MySQL 8+ / MariaDB 10.4+)
# Use a dedicated database user with a strong password, not root.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=aalto_mart
DB_USERNAME=
DB_PASSWORD=
DB_CHARSET=utf8mb4

# Session
SESSION_NAME=aalto_session
# Secure (HTTPS-only) session cookie. It is switched on automatically
# for HTTPS requests; set true to force it.
SESSION_SECURE=false

# Admin authentication
# Sign out after this many seconds of inactivity (30 min)
ADMIN_SESSION_IDLE=1800
# Hard limit on an admin session, active or not (8 h)
ADMIN_SESSION_LIFETIME=28800
# Lock login after this many failures for one email from one IP...
ADMIN_LOGIN_MAX_ATTEMPTS=5
# ...or this many failures from one IP for any email
ADMIN_LOGIN_MAX_ATTEMPTS_IP=20
# Length of the failure window / lockout
ADMIN_LOGIN_LOCKOUT_MINUTES=15

# Image uploads (JPG, PNG, WebP): largest file accepted from the browser, in KB.
# Every image is then cropped, resized and compressed to its standard
# (sizes, ratios, targets: app/config/images.php). 8 MB fits phone photos.
UPLOAD_IMAGE_MAX_KB=8192
